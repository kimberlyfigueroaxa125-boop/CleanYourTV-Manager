<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>UninstallDialog</class>
 <widget class="QDialog" name="UninstallDialog">
  <property name="windowTitle"><string>Удаление CleanYourTV</string></property>
  <property name="minimumSize"><size><width>520</width><height>260</height></size></property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item><widget class="QLabel" name="warningTitle"><property name="text"><string>Удалить CleanYourTV?</string></property><property name="styleSheet"><string>font-size: 20px; font-weight: 700;</string></property></widget></item>
   <item><widget class="QLabel" name="warningText"><property name="wordWrap"><bool>true</bool></property><property name="text"><string>Будет удалена только локальная папка CleanYourTV на этом компьютере. Телевизор, приложения Android, ADB и настройки ТВ не изменяются.</string></property></widget></item>
   <item><widget class="QLabel" name="pathLabel"><property name="wordWrap"><bool>true</bool></property><property name="text"><string>Путь: —</string></property></widget></item>
   <item><widget class="QCheckBox" name="confirmCheck"><property name="text"><string>Я понимаю, что локальные файлы CleanYourTV будут удалены</string></property></widget></item>
   <item><spacer name="verticalSpacer"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint"><size><width>20</width><height>20</height></size></property></spacer></item>
   <item><layout class="QHBoxLayout" name="buttonsLayout">
    <item><spacer name="horizontalSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint"><size><width>40</width><height>20</height></size></property></spacer></item>
    <item><widget class="QPushButton" name="cancelButton"><property name="text"><string>Отмена</string></property></widget></item>
    <item><widget class="QPushButton" name="deleteButton"><property name="text"><string>Удалить CleanYourTV</string></property><property name="enabled"><bool>false</bool></property></widget></item>
   </layout></item>
  </layout>
 </widget>
