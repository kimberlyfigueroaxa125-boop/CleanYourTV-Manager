 <class>TvUninstallDialog</class>
 <widget class="QDialog" name="TvUninstallDialog">
  <property name="windowTitle"><string>Remove CleanYourTV from TV</string></property>
  <property name="minimumSize"><size><width>560</width><height>300</height></size></property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
