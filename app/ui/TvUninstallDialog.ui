    </widget>
   </item>
   <item>
    <widget class="QLabel" name="warningText">
     <property name="wordWrap"><bool>true</bool></property>
     <property name="text"><string>The app will first enable the stock Google TV Launcher, set it as Home, and verify the result. If verification fails, CleanYourTV will not be removed. Only the CleanYourTV package for Android user 0 is targeted. Live TV and TV Input system packages are not modified.</string></property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="deviceLabel">
     <property name="wordWrap"><bool>true</bool></property>
     <property name="text"><string>Device: —</string></property>
    </widget>
   </item>
   <item>
    <widget class="QCheckBox" name="confirmCheck">
     <property name="text"><string>I understand that CleanYourTV will be removed from the TV</string></property>
    </widget>
   </item>
   <item>
    <spacer name="verticalSpacer">
     <property name="orientation"><enum>Qt::Vertical</enum></property>
     <property name="sizeHint"><size><width>20</width><height>20</height></size></property>
    </spacer>
   </item>
   <item>
    <layout class="QHBoxLayout" name="buttonsLayout">
     <item>
