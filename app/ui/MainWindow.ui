           <item><widget class="QLabel" name="welcomeHint"><property name="text"><string>Подключитесь к Android TV, чтобы посмотреть состояние устройства и запускать инструменты.</string></property><property name="wordWrap"><bool>true</bool></property><property name="styleSheet"><string>color:#8190a5;</string></property></widget></item>
